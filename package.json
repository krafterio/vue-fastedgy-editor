{
    "name": "vue-fastedgy-editor",
    "version": "0.1.0",
    "description": "Rich text and document editor for FastEdgy applications, on Tiptap, storing documents as markdown",
    "type": "module",
    "main": "./index.js",
    "types": "./types/index.d.ts",
    "license": "MIT",
    "exports": {
        ".": {
            "import": "./index.js",
            "types": "./types/index.d.ts"
        },
        "./styles.css": "./styles/editor.css"
    },
    "scripts": {
        "build": "vue-tsc -p tsconfig.json",
        "lint": "npm run build && oxlint . --type-aware",
        "fix": "oxlint --fix",
        "format": "oxfmt --write index.js components composables extensions features markdown render tests vitest.config.js",
        "fcl": "npm run fix && npm run format && npm run lint",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@tiptap/core": "^3.31.0",
        "@tiptap/extension-blockquote": "^3.31.0",
        "@tiptap/extension-bold": "^3.31.0",
        "@tiptap/extension-bullet-list": "^3.31.0",
        "@tiptap/extension-code": "^3.31.0",
        "@tiptap/extension-code-block-lowlight": "^3.31.3",
        "@tiptap/extension-document": "^3.31.0",
        "@tiptap/extension-dropcursor": "^3.31.0",
        "@tiptap/extension-gapcursor": "^3.31.0",
        "@tiptap/extension-hard-break": "^3.31.0",
        "@tiptap/extension-heading": "^3.31.0",
        "@tiptap/extension-history": "^3.31.0",
        "@tiptap/extension-horizontal-rule": "^3.31.0",
        "@tiptap/extension-image": "^3.31.3",
        "@tiptap/extension-italic": "^3.31.0",
        "@tiptap/extension-link": "^3.31.0",
        "@tiptap/extension-list-item": "^3.31.0",
        "@tiptap/extension-mention": "^3.31.3",
        "@tiptap/extension-ordered-list": "^3.31.0",
        "@tiptap/extension-paragraph": "^3.31.0",
        "@tiptap/extension-placeholder": "^3.31.0",
        "@tiptap/extension-strike": "^3.31.0",
        "@tiptap/extension-table": "^3.31.3",
        "@tiptap/extension-task-item": "^3.31.3",
        "@tiptap/extension-task-list": "^3.31.3",
        "@tiptap/extension-text": "^3.31.0",
        "@tiptap/extension-underline": "^3.31.0",
        "@tiptap/pm": "^3.31.0",
        "@tiptap/suggestion": "^3.31.3",
        "@tiptap/vue-3": "^3.31.0",
        "lowlight": "^3.3.0",
        "markdown-it": "^15.0.0"
    },
    "peerDependencies": {
        "reka-ui": "^2.10.0",
        "vue": "^3.5.0",
        "vue-fastedgy": "*"
    },
    "devDependencies": {
        "@types/node": "^26.5.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.4",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "oxlint-tsgolint": "^7.0.2001",
        "reka-ui": "^2.10.4",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0",
        "vue": "^3.5.42",
        "vue-fastedgy": "github:krafterio/vue-fastedgy#main",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "allowScripts": {
        "esbuild": false,
        "fsevents": false
    }
}
